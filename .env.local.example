# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/nback_game

# Better Auth
# Сгенерируйте секрет: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Game Settings
DEFAULT_N_VALUE=2
DEFAULT_STIMULUS_INTERVAL=1500
MAX_STIMULUS_SPEED=500
